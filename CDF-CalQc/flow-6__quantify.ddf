'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'extra': {'current': 'matplot_v2', 'alllist': ['matplot_v2'], 'extra-text': "def matplot_v2(data, params):\n\timport matplotlib as mpl\n\tfig = mpl.figure.Figure((12,8))\n\tax = fig.add_axes([0.1, 0.1, 0.8, 0.8])\n\ttol = params.get('rt_tol', 10)\n\ti = 0\n\tfor i,(g,d) in enumerate(data.groupby('Molecule Name')):\n\t\ty = d['RT(Sec)']\n\t\tx = d['Sample Injection Order']\n\t\tms, lw = (6,0) if x.size > 1000 else (8,1)\n\t\tax1, = ax.plot(x, y, '-o', label=g, mec='white', mew=lw, markersize=ms, linewidth=1)\n\t\tcol = ax1.get_color()\n\t\tax.add_patch(mpl.patches.Rectangle((1, y.mean()-tol), x.max()-1, tol*2, color=col, alpha=0.1))\n\n\trt_min = data['RT(Sec)'].min()\n\trt_max = data['RT(Sec)'].max()\n\trt_range = max(rt_max-rt_min, 200) * 0.1*(i//3+1)\n\tax.set_ylabel('RT (Sec)')\n\tax.set_title('Retention time quanlity control')\n\tax.set_ylim(rt_min-30, rt_max+rt_range)\n\tax.set_xlabel('Sample Injection Order')\n\tax.legend(loc='upper center', ncol=3)\n\treturn [fig.figure]\n"}, 'Annotation': ('', 'markdown')}}}, {'class': 'Matplotlib Script', 'name': 'Matplotlib Script(2)', 'pos': (1899.999999999999, 960.0000000000007), 'state': {'pos': (1899.999999999999, 960.0000000000007), 'bypass': False, 'checked': True, 'terminals': OrderedDict([('Data', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Params', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Figures', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'extra': {'current': 'matplot_v2', 'alllist': ['matplot_v2'], 'extra-text': "def matplot_v2(data, params):\n\timport matplotlib as mpl\n\tfig = mpl.figure.Figure((12,8))\n\tax = fig.add_axes([0.1, 0.1, 0.8, 0.8])\n\ttol = params.get('rt_tol', 10)\n\t\n\tfor i,(g,d) in enumerate(data.groupby('Molecule Name')):\n\t\ty = d['RT(Sec)']\n\t\tx = d['Sample Injection Order']\n\t\tms, lw = (6,0) if x.size > 1000 else (8,1)\n\t\tax1, = ax.plot(x, y, '-o', label=g, mec='white', mew=lw, markersize=ms, linewidth=1)\n\t\tcol = ax1.get_color()\n\t\tax.add_patch(mpl.patches.Rectangle((1, y.mean()-tol), x.max()-1, tol*2, color=col, alpha=0.1))\n\n\trt_min = data['RT(Sec)'].min()\n\trt_max = data['RT(Sec)'].max()\n\trt_range = max(rt_max-rt_min, 200) * 0.1*(i//3+1)\n\tax.set_ylabel('RT (Sec)')\n\tax.set_title('Retention time quanlity control')\n\tax.set_ylim(rt_min-30, rt_max+rt_range)\n\tax.set_xlabel('Sample Injection Order')\n\tax.legend(loc='upper center', ncol=3)\n\treturn [fig.figure]\n"}, 'Annotation': ('', 'markdown')}}}, {'class': 'Selection Items', 'name': 'Selection Items(2)', 'pos': (900.0, -1072.0), 'state': {'pos': (900.0, -1072.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('I-Data', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('O-1st', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('O-Data', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Selections': {'all': False, 'rev': False, 'lock': False, 'list': (['Degree_1', 'Degree_2'], [True, True]), 'mode': 'AnyFile'}, 'Annotation': ('<!DOCTYPE html>\n<title>(0) Select Calibrators Degree</title>', 'markdown')}}}, {'class': 'DDF UPDATER', 'name': 'DDF UPDATER(1)', 'pos': (-2250.0, -128.0), 'state': {'pos': (-2250.0, -128.0), 'bypass': False, 'checked': True, 'terminals': OrderedDict([('I-Data', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('O-Data', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Controller': {'check': True, 'spinbox':