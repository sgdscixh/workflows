rs(x, *args):\n\n\n\tif not x.get("合并方式[GRP_TYPE]"):\n\t\treturn {}\n\n\tpair = x["合并方式[GRP_TYPE]"]\n\tp_cur = app._work_dir\n\tcurs = re.findall(pair, p_cur)\n\tp_map = {}\n\tif not curs: return p_map\n\n\tcur = curs[0]\n\t\n\tfor i in pair.split("|"):\n\t\tp_map[i] = p_cur.replace(cur, i)\n\treturn p_map\n\n\n\n\ndef merge_table(d, p, p0):\n    f_name = os.basename(p)\n\n    df_list = []\n    for k,v in p0.items():\n        f_path_i = f"{v}/results/{f_name}"\n        if os.path.exists(f_path_i):\n            df = pd.read_excel(f_path_i)\n            df_list.append(df)\n\n    df_all = pd.concat(df_list, ignore_index=True)\n\n\n    for k,v in p0.items():\n        f_path_i = f"{v}/results/{f_name}"\n        with pd.ExcelWriter(f_path_i, mode="a", engine="openpyxl",if_sheet_exists=\'replace\') as writer:\n            df_all.sort_values("molecule").to_excel(writer, sheet_name="merge",index=False)\n    return df_all'}, 'Annotation': ('', 'markdown')}}}, {'class': 'DDF PROXY', 'name': 'DDF PROXY(8)', 'pos': (4700.0, -464.0), 'state': {'pos': (4700.0, -464.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('dict', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'FLOW-PORT': 'dict', 'Annotation': ('', 'markdown')}}}, {'class': 'Pivot-Table', 'name': 'Pivot-Table(5)', 'pos': (1450.0, 480.0000000000001), 'state': {'pos': (1450.0, 480.0000000000001), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('Table-in', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Table-out', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Index': {'all': False, 'rev': False, 'lock': False, 'list': (['chromId', 'FUNCTION', 'g_auc', 'polarity', 'product_rank'], [True, False, False, True, False]), 'mode': 'AnyFile'}, 'Columns': {'all': False, 'rev': False, 'lock': F