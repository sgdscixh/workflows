igure.Figure((8,10))\n\tax = fig.subplots()\n\tps = x.query(f"index.isin({p1.point.tolist()})")\n\t\n\tx["color"] = "grey"\n\tx.loc[ps.index, \'color\'] = "black"\n\tx.loc[x.sample_name.isin(p2), \'color\'] = "blue"\n\tax.plot(x.concentration, cy, color=\'blue\')\n\tfor i,p in enumerate(x.color):\n\t\tax.plot(x.concentration.iloc[i], x.ratio.iloc[i], \'s\', color=p, ms=8, alpha=0.7)\n\t\n\n\tax.set_xlabel("Concentration")\n\tax.set_ylabel("Ratio")\n\tax.text(0.05, 0.95, f"Transition : {p1.feature}", transform=ax.transAxes, fontsize=12)\n\t\n\tax.text(0.05, 0.90, f"R^2 = {p1.score: .4f}, Weight = x^{p1.weight}", transform=ax.transAxes, fontsize=12)\n\tfig.set_tight_layout(True)\n\treturn fig'}, 'Annotation': ('', 'markdown')}}}, {'class': 'DataFrame.eval', 'name': 'DataFrame.eval(5)', 'pos': (1200.0, -255.99999999999997), 'state': {'pos': (1200.0, -255.99999999999997), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('iData', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('oData', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Engine': {'current': 'python', 'alllist': ['python', 'numexpr']}, 'Inplace': False, 'Imports': '', 'Command': 'check = True', 'Annotation': ('', 'markdown')}}}, {'class': 'DataFrame.query', 'name': 'DataFrame.query(5)', 'pos': (1450.0, -16.0), 'state': {'pos': (1450.0, -16.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('I-Data', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Params', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('O-Data', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Engine': {'current': 'python', 'alllist': ['python', 'numexpr']}, 'Inplace': False, 'ReInd