0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('I-Data', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Extend', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('O-Data', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Columns', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Return': {'current': 'DataFrame', 'alllist': ['DataFrame', 'Series[C]', 'Series[R]', 'flatArray', 'ndArray', 'List', 'Series', 'flatList']}, 'Column': {'all': False, 'rev': False, 'lock': False, 'list': (['molecule', 'Compound Name', 'Class', 'Formula', 'Molecular Weight (Da)'], [True, True, False, False, False]), 'mode': 'AnyFile'}, 'Pattern': '.+', 'Unique': False, 'Annotation': ('', 'markdown')}}}, {'class': 'Files-matched', 'name': 'Files-matched(2)', 'pos': (1000.0, -1136.0), 'state': {'pos': (1000.0, -1136.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('Signal', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Files', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Auto': True, 'Sort': True, 'Directory': './', 'Pattern': 'headMessage.+', 'Annotation': ('', 'markdown')}}}, {'class': 'Python Script', 'name': 'Python Script(1)', 'pos': (1550.0, -1552.0), 'state': {'pos': (1550.0, -1552.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('Input', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Param-1', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Param-2', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Output', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'extra': {'current': 'extract_annotation_sheet', 'alllist': ['extract_annotation_sheet'], 'extra-text': 'def extract_annotation_sheet(anno_file, head_file, param2):\n    """\n    从 Annotation-Lipids6000.xlsx 中提取指定sheet的数据\n    \n    参数:\n        anno_file: Annotation-Lipids6000.xlsx 文件路径 (来自 Input 端口)\n        head_file: headMessage__Lipids__nmol.xlsx 文件路径 (来自 Param-1 端口)\n        param2: 备用参数 (来自 Param-2 端口,本例中未使用)\n    \n    返回:\n        DataFrame: 读取成功的 Annotation sheet 数据\n    """\n    import pandas as pd\n    import os\n    \n    # 1. 验证文件路径\n    if isinstance(anno_file, list):\n        anno_file = anno_file[0]\n    if isinstance(head_file, list):\n        head_file = head_file[0]\n    \n    if not os.path.exists(anno_file):\n        raise FileNotFoundError(f"Annotation文件不存在: {anno_file}")\n    if not os.path.exists(head_file):\n        raise FileNotFoundError(f"HeadMessage文件不存在: {head_file}")\n    \n    # 2. 读取 headMessage 文件的 \'head\' sheet\n    # header=None 表示不使用第一行作为列名,所有数据按原样读取\n    head_df = pd.read_excel(head_file, sheet_name=\'head\', header=None)\n    \n    # 3. 查找"使用数据库"所在的行\n    # 在第一列(索引0)中查找包含"使用数据库"的行\n    db_row_mask = head_df[0] == \'使用数据库\'\n    \n    if not db_row_mask.any():\n        raise ValueError(f"在 head sheet 中未找到\'使用数据库\'行。可用的第一列数据: {head_df[0].tolist()}")\n    \n    # 获取"使用数据库"行的索引\n    db_row_idx = head_df[db_row_mask].index[0]\n    \n    # 4. 获取第二列(索引1)的值,即数据库类型: Total/Animal/Plant\n    db_type = head_df.iloc[db_row_idx, 1]\n    \n    # 去除可能的空格\n    db_type = str(db_type).strip()\n    \n    # 5. 构造对应的 sheet 名称\n    sheet_name = f\'Annotation-{db_type}\'\n    \n    # 6. 读取 Annotation-Lipids6000.xlsx 对应的 sheet\n    try:\n        anno_df = pd.read_excel(anno_file, sheet_name=sheet_name)\n        print(f"✓ 成功读取 sheet: {sheet_name}, 数据形状: {anno_df.shape}")\n        return anno_df\n    except Exception as e:\n        # 如果读取失败,列出所有可用的 sheet 名称\n        xl_file = pd.ExcelFile(anno_file)\n        available_sheets = xl_file.sheet_names\n        raise ValueError(\n            f"读取 sheet \'{sheet_name}\' 失败: {str(e)}\\n"\n            f"数据库类型: {db_type}\\n"\n            f"可用的 sheet 列表: {available_sheets}"\n        )'}, 'Annotation': ('', 'markdown')}}}]
