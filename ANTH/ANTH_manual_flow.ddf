e->File(1)', 'pos': (5331.1440054738105, 19.28869421185317), 'state': {'pos': (5331.1440054738105, 19.28869421185317), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('Iterable', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Path[in]', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Path[out]', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Path[txt]': '', 'Mode': {'current': 'Write', 'alllist': ['Write', 'Append', 'Write[b]', 'Append[b]']}, 'Annotation': ('', 'markdown')}}}, {'class': 'Iterable->File', 'name': 'Iterable->File(2)', 'pos': (5350.0, 144.0), 'state': {'pos': (5350.0, 144.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('Iterable', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Path[in]', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Path[out]', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Path[txt]': '', 'Mode': {'current': 'Write', 'alllist': ['Write', 'Append', 'Write[b]', 'Append[b]']}, 'Annotation': ('', 'markdown')}}}, {'class': 'All Finished', 'name': 'All Finished(2)', 'pos': (5350.0, 288.0), 'state': {'pos': (5350.0, 288.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('In', {'io': 'in', 'multi': True, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Out', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('O-Signal', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Progress': True, 'O-Signal': True, 'Annotation': ('', 'markdown')}}}, {'class': 'Python Script', 'name': 'Python Script(5)', 'pos': (1200.0, 1264.0), 'state': {'pos': (1200.0, 1264.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('Input', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Param-1', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Param-2', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Output', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'extra': {'current': 'transform_data', 'alllist': ['pd', 'transform_data'], 'extra-text': 'import pandas as pd\n\ndef transform_data(data, params,*arg):\n    """\n    将宽格式的原始表格转换为长格式，并根据params过滤物质列\n    \n    参数:\n    data: 原始DataFrame，包含sample_type, sample_name, concentration(ng/mL)和物质列\n    params: 物质名称DataFrame或列表，用于过滤\n    \n    返回:\n    转换后的DataFrame，包含sample_type, sample_name, feature_id, concentration, peak_area\n    """\n    # 1. 处理params参数 - 兼容DataFrame和列表格式\n    if isinstance(params, pd.DataFrame):\n        # 从DataFrame中提取第一列作为物质名称列表\n        params_list = params.iloc[:, 0].tolist()\n    else:\n        # 如果已经是列表，直接使用\n        params_list = params\n    \n    # 2. 获取固定列和物质列\n    fixed_cols = [\'sample_type\', \'sample_name\', \'concentration(ng/mL)\']\n    all_substance_cols = [col for col in data.columns if col not in fixed_cols]\n    \n    # 3. 根据params_list过滤物质列\n    filtered_substance_cols = [col for col in all_substance_cols if col in params_list]\n    \n    # 4. 使用melt转换为长格式\n    df_long = pd.melt(\n        data,\n        id_vars=fixed_cols,\n        value_vars=filtered_substance_cols,\n        var_name=\'feature_id\',\n        value_name=\'peak_area\'\n    )\n    \n    # 5. 重命名concentration列\n    df_long = df_long.rename(columns={\'concentration(ng/mL)\': \'concentration\'})\n    \n    # 6. 过滤掉peak_area为"N/A"的行\n    df_long = df_long[df_long[\'peak_area\'] != \'N/A\']\n    \n    # 7. 调整列顺序\n    df_long = df_long[[\'sample_type\', \'sample_name\', \'feature_id\', \'concentration\', \'peak_area\']]\n    \n    # 8. 重置索引\n    df_long = df_long.reset_index(drop=True)\n    \n    return df_long'}, 'Annotation': ('', 'markdown')}}}, {'class': 'DataFrame.read', 'name': 'DataFrame.read(9)', 'pos': (900.0000000000001, 1168.0), 'state': {'pos': (900.0000000000001, 1168.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('I-Files', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Table-1st', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('O-Tables', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Columns': '', 'columns': {'current': 'string', 'value': 'calibrator_area', 'types': ['int', 'string']}, 'Encoding': 'utf-8', 'NA-Values': '...', 'Delimiter': '\\t', 'Keep-Path': False, 'Annotation': ('', 'markdown')}}}, {'class': 'DataFrame.read', 'name': 'DataFrame.read(10)', 'pos': (600.0, 1360.0), 'state': {'pos': (600.0, 1360.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('I-Files', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Table-1st', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('O-Tables', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Columns': '', 'columns': {'current': 'string', 'value': 'Analyte_for_Calibration', 'types': ['int', 'string']}, 'Encoding': 'utf-8', 'NA-Values': '...', 'Delimiter': '\\t', 'Keep-Path': False, 'Annotation': ('', 'markdown')}}}, {'class': 'Dimension->Select', 'name': 'Dimension->Select