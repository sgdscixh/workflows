 False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Engine': {'current': 'python', 'alllist': ['python', 'numexpr']}, 'Inplace': False, 'Imports': '\ndef calc_stats(row):\n    """同时计算RSD和均值"""\n    import numpy as np\n    import pandas as pd\n    \n    # 提取QC列的值（跳过第一列物质名称）\n    qc_values = row[1:]\n    # 过滤掉NaN值\n    qc_values = qc_values.dropna()\n    \n    if len(qc_values) < 2:\n        return pd.Series({\'RSD\': np.nan, \'accuracy\': np.nan})\n    \n    mean_val = qc_values.mean()\n    std_val = qc_values.std()\n    \n    # RSD = (标准差 / 平均值) × 100%\n    if mean_val == 0:\n        rsd = np.nan\n    else:\n        rsd = (std_val / mean_val) * 100\n    \n    # 返回包含两个值的 Series\n    return pd.Series({\'RSD\': rsd, \'accuracy\': mean_val})\n\n', 'Command': 'data.apply(calc_stats, axis=1)\n', 'Annotation': ('', 'markdown')}}}, {'class': 'Concat-Table[C]', 'name': 'Concat-Table[C](1)', 'pos': (2700.0, 511.99999999999983), 'state': {'pos': (2700.0, 511.99999999999983), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('Data', {'io': 'in', 'multi': True, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Concat', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'All-need': False, 'Annotation': ('', 'markdown')}}}, {'class': 'DataFrame.query', 'name': 'DataFrame.query(3)', 'pos': (1250.0, 16.0), 'state': {'pos': (1250.0, 16.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('I-Data', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Params', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('O-Data', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Engine': {'current': 'python', 'alllist': ['python', 'numexpr']}, 'Inplac