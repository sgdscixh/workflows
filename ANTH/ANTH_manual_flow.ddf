{'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Headers': {'all': False, 'rev': False, 'lock': False, 'list': (['Compound Name (ng/mL)', 'concentration', 'RSD[%]', 'Accuracy[%]'], [True, False, False, False]), 'mode': 'AnyFile'}, 'Re Index': False, 'Sorting': {'all': False, 'rev': False, 'lock': False, 'list': (['Compound Name (ng/mL)'], [True]), 'mode': 'AnyFile'}, 'Annotation': ('', 'markdown')}}}, {'class': 'DataFrame.query', 'name': 'DataFrame.query(7)', 'pos': (3700.0, 816.0), 'state': {'pos': (3700.0, 816.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('I-Data', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Params', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('O-Data', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Engine': {'current': 'python', 'alllist': ['python', 'numexpr']}, 'Inplace': False, 'ReIndex': False, 'Command': 'R2>0.99', 'Annotation': ('', 'markdown')}}}, {'class': 'Pandas.eval', 'name': 'Pandas.eval(8)', 'pos': (2300.0, 672.0), 'state': {'pos': (2300.0, 672.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('I-Data', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('O-Data', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Engine': {'current': 'python', 'alllist': ['python', 'numexpr']}, 'Inplace': False, 'Imports': 'def calc_stats(row):\n    """同时计算RSD和均值"""\n    import numpy as np\n    import pandas as pd\n    \n    # 提取QC列的值（跳过第一列物质名称）\n    qc_values = row[1:]\n    # 过滤掉NaN值\n    qc_values = qc_values.dropna()\n    \n    # 处理QC数量为0的情况\n    if len(qc_values) == 0:\n        return pd.Series({\'RSD\': np.nan, \'accuracy\': np.nan})\n    \n    # 处理QC数量为1的情况\n    elif len(qc_values) == 1:\n        mean_val = qc_values.iloc[0]  # 唯一的值作为均值\n        rsd = 0  # RSD设为0\n        \n        return pd.Series({\'RSD\': rsd, \'accuracy\': mean_val})\n    \n    # 处理QC数量大于等于2的情况\n    else:\n        mean_val = qc_values.mean()\n        std_val = qc_values.std()\n        \n        # RSD = (标准差 / 平均值) × 100%\n        if mean_val == 0:\n            rsd = np.nan\n        else:\n            rsd = (std_val / mean_val) * 100\n        \n        return pd.Series({\'RSD\': rsd, \'accuracy\': mean_val})', 'Command': 'data.apply(calc_stats, axis=1)', 'Annotation': ('', 'markdown')}}}]
