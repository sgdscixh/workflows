alse, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False]), 'mode': 'AnyFile'}, 'How': {'current': 'left', 'alllist': ['left', 'right', 'outer', 'inner', 'cross']}, 'Left index': False, 'Right index': False, 'Sort': True, 'Suffixes': '_x;_y', 'Copy': True, 'Indicator': False, 'Validate': {'current': 'None', 'alllist': ['None', 'one_to_one', 'one_to_many', 'many_to_one', 'many_to_many']}, 'Annotation': ('', 'markdown')}}}, {'class': 'Dimension->Select', 'name': 'Dimension->Select(1)', 'pos': (2250.0, -176.0), 'state': {'pos': (2250.0, -176.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('I-Data', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Extend', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('O-Data', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Columns', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Return': {'current': 'DataFrame', 'alllist': ['DataFrame', 'Series[C]', 'Series[R]', 'flatArray', 'ndArray', 'List', 'Series', 'flatList']}, 'Column': {'all': False, 'rev': False, 'lock': False, 'list': (['Compound Name (nmol/L)', 'ZCM1', 'ZCM3', 'ZCM2'], [True, False, False, False]), 'mode': 'AnyFile'}, 'Pattern': '', 'Unique': False, 'Annotation': ('', 'markdown')}}}, {'class': 'Python Script', 'name': 'Python Script(2)', 'pos': (2250.0, 0.0), 'state': {'pos': (2250.0, 0.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('Input', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Param-1', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Param-2', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Output', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'extra': {'current': 'calculate_samples', 'alllist': ['calculate_samples'], 'extra-text': 'def calculate_samples(df, metadata_df, unit_df):\n    """\n    对数据框中的样本列进行计算\n    \n    参数:\n    df: 原始数据框，包含样本列和计算所需的参数列\n    metadata_df: 包含样本名称的元数据框\n    unit_df: 包含单位因子的数据框\n    \n    返回:\n    计算后的数据框\n    """\n    result_df = df.copy()\n    \n    # 获取需要计算的样本列名\n    sample_columns = metadata_df[\'Compound Name (nmol/L)\'].tolist() \n    \n    # 筛选出实际存在于df中的样本列\n    valid_samples = [col for col in sample_columns if col in df.columns]\n    \n    # 获取单位因子\n    unit_factor = unit_df[\'unitFactor\'].iloc[0] if not unit_df.empty else 1\n    \n    # 检查df中是否包含所有需要的参数列\n    required_columns = [\'提取体积(μL)\', \'稀释因子\', \'称样量(mg)\', \'浓缩因子\']\n    for col in required_columns:\n        if col not in df.columns:\n            raise ValueError(f"数据框中缺少必要的列: {col}")\n    \n    # 对于每个有效样本列进行计算\n    for sample in valid_samples:\n        # 对df的每一行进行计算\n        result_df[sample] = (\n            df[sample] * \n            df[\'提取体积(μL)\'] * \n            df[\'稀释因子\'] / \n            df[\'称样量(mg)\'] / \n            df[\'浓缩因子\'] / \n            unit_factor\n        )\n    \n    # 只返回sample_name列和计算后的样本列\n    columns_to_keep = [\'sample_name\'] + valid_samples\n    result_df = result_df[columns_to_keep]\n    \n    return result_df'}, 'Annotation': ('', 'markdown')}}}, {'class': 'Files-matched', 'name': 'Files-matched(4)', 'pos': (550.0, 239.99999999999994), 'state': {'pos': (550.0, 239.99999999999994), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('Signal', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Files', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Auto': False, 'Sort': True, 'Directory': './', 'Pattern': 'headMessage_.+', 'Annotation': ('', 'markdown')}}}, {'class': 'DataFrame.read', 'name': 'DataFrame.read(3)', 'pos': (850.0000000000001, 160.0), 'state': {'pos': (850.0000000000001, 160.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('I-Files', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Table-1st', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('O-Tables', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Columns': '', 'columns': {'current': 'string', 'value': '样本类型', 'types': ['int', 'string']}, 'Encoding': 'utf-8', 'NA-Values': '...', 'Delimiter': '\\t', 'Keep-Path': False, 'Annotation': ('', 'markdown')}}}, {'class': 'Python Script', 'name': 'Python Script(3)', 'pos': (2650.0, 0.0), 'state': {'pos': (2650.0, 0.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('Input', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Param-1', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Param-2', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Output', {'io': 'out', 'multi': False, 'optional': False, 'renamable': Fa