read_table_sheet <- function(f, sheet='merge', default=1){
sheets <- readxl::excel_sheets(f)
if(sheet %in% sheets){
df_data <- readxl::read_xlsx(f, sheet = sheet, na='#N/A')
}else {
df_data <- readxl::read_xlsx(f, sheet = default, na='#N/A')
}
return(df_data)
}
