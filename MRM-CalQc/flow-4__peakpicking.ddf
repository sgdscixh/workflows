8.0), 'state': {'pos': (1399.9999999999995, 368.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('I-Data', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('O-Data', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Engine': {'current': 'python', 'alllist': ['python', 'numexpr']}, 'Inplace': False, 'Imports': 'def cosine(d):\n\timport numpy as np\n\tx,y = d\n\tp12 = np.sum(x*y)\n\tp11 = np.square(x)\n\tp22 = np.square(y)\n\tpa11 = np.sqrt(p11.sum())\n\tpa22 = np.sqrt(p22.sum())\n\treturn p12/(pa11*pa22)\n\ndef score(d):\n\tfrom scipy import stats\n\tx,y = d\n\tif x.size==1:\n\t\treturn 1\n\telif x.size==2:\n\t\trx = x[1]/x[0]\t\n\t\try = y[1]/y[0]\n\t\treturn rx/ry if rx<ry else ry/rx\n\telse:\n\t\treturn stats.pearsonr(x,y).statistic\n\t\n\t', 'Command': "score_tra = data[['product_ratio','peak_area']].apply(cosine, axis=1)", 'Annotation': ('', 'markdown')}}}, {'class': 'Merge-Table', 'name': 'Merge-Table(6)', 'pos': (1700.0000000000002, 160.00000000000017), 'state': {'pos': (1700.0000000000002, 160.00000000000017), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('Table-left', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Table-right', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Table-out', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Left on': {'all': False, 'rev': False, 'lock': False, 'list': (['sample_type', 'sample_name', 'chromId', 'group_tra', 'checkSum', 'filePath', 'type', 'conc', 'precursor_mz', 'product_mz', 'precursor_charge', 'ratio_to', 'rt_sec', 'polarity', 'product_rank', 'sampleAmount', 'aquire_index', 'id', 'scale', 'rtShift', 'rtTolfc', 'extractorVol', 'level2', 'rt_cal', 'r_