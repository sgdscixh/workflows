ct([('dict', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Proxy Flows': {'current': 'FLOW(6)', 'alllist': ['MAIN FLOW', 'FLOW(1)', 'FLOW(2)', 'FLOW(3)', 'FLOW(4)', 'FLOW(5)', 'FLOW(6)', 'FLOW(7)', 'FLOW(8)', 'FLOW(9)', 'FLOW(10)', 'FLOW(11)']}, 'Proxy Nodes': {'current': 'DDF PROXY(8)', 'alllist': ['DDF PROXY(1)', 'DDF PROXY(2)', 'DDF PROXY(3)', 'DDF PROXY(4)', 'DDF PROXY(5)', 'DDF PROXY(6)', 'DDF PROXY(7)', 'DDF PROXY(8)']}, 'Proxy Node': 'DDF PROXY(8)', 'Controller': {'check': False, 'spinbox': 0}, 'Annotation': ('', 'markdown')}}}, {'class': 'Python Script', 'name': 'Python Script(2)', 'pos': (5250.0, -1999.9999999999998), 'state': {'pos': (5250.0, -1999.9999999999998), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('Input', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Param-1', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Param-2', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Output', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'extra': {'current': 'merge_pdfs', 'alllist': ['os', 're', 'get_pairs', 'copy_figures', 'merge_pdfs'], 'extra-text': '###\nimport os, re\n\ndef get_pairs(x, *args):\n\n\n\tif "合并方式[GRP_TYPE]" not in x:\n\t\treturn None\n\n\tpair = x.iloc[0]["合并方式[GRP_TYPE]"]\n\tp_cur = app._work_dir\n\tcurs = re.findall(pair, p_cur)\n\tp_map = {}\n\tif not curs: return p_map\n\n\tcur = curs[0]\n\t\n\tfor i in pair.split("|"):\n\t\tp_map[i] = p_cur.replace(cur, i)\n\treturn p_map\n\n\n\n\ndef copy_figures(d, p, p0):\n    f_name = os.path.basename(d)\n\n    from PyPDF4 import PdfFileMerger\n    merger = PdfFileMerger(strict=False)\n    for k,v in p0.items():\n        f_path_i = f"{v}/results/{d}"\n        if os.path.exists(f_path_i):\n             merger.append(fileobj=open(f_path_i, \'rb\'), import_bookmarks=True)\n    base, ext = os.path.splitext(f_name)\n    for k,v in p0.items():\n        merger.write(fileobj=open(f\'{v}/results/figures/{base}-merge.pdf\', \'wb\'))\n\n\ndef merge_pdfs(d, p, p0):\n    if p0:\n        for k,v in d.items():\n            copy_figures(d=v, p=p, p0=p0)\n    return len(d)\n\n\n\n'}, 'Annotation': ('', 'markdown')}}}, {'class': 'Parameters[dict]', 'name': 'Parameters[dict](1)', 'pos': (4950.0, -2128.0), 'state': {'pos': (4950.0, -2128.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('Params', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Params': 'TIC = "/figures/TIC-SPL.pdf"\nXIC = "/figures/XIC-SPL.pdf"\nCAL = "/figures/Calibrators.best.pdf"', 'Annotation': ('', 'markdown')}}}, {'class': 'Python Script', 'name': 'Python Script(3)', 'pos': (5250.0, -2160.0), 'state': {'pos': (5250.0, -2160.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('Input', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Param-1', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Param-2', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Output', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'extra': {'current': 'merge_tables', 'alllist': ['os', 're', 'get_pairs', 'merge_table', 'copy_figures', 'merge_pdfs', 'merge_tables'], 'extra-text': '###\nimport os, re\n\ndef get_pairs(x, *args):\n\n\n\tif "合并方式[GRP_TYPE]" not in x:\n\t\treturn None\n\n\tpair = x.iloc[0]["合并方式[GRP_TYPE]"]\n\tp_cur = app._work_dir\n\tcurs = re.findall(pair, p_cur)\n\tp_map = {}\n\tif not curs: return p_map\n\n\tcur = curs[0]\n\t\n\tfor i in pair.split("|"):\n\t\tp_map[i] = p_cur.replace(cur, i)\n\treturn p_map\n\n\n\n\ndef merge_table(f, s, p0):\n    import os\n    f_name = os.path.basename(f)\n    s_name = s\n    if p0=={}: return\n\n    df_list = []\n    for k,v in p0.items():\n        f_path_i = f"{v}/results/{f}"\n        if os.path.exists(f_path_i):\n            df = pd.read_excel(f_path_i, sheet_name=s_name)\n            df["$GRP_TYPE"] = k\n            df_list.append(df)\n\n    df_all = pd.concat(df_list, ignore_index=True)\n\n\n    for k,v in p0.items():\n        f_path_i = f"{v}/results/{f}"\n        with pd.ExcelWriter(f_path_i, mode="a", engine="openpyxl",if_sheet_exists=\'replace\') as writer:\n            df_all.to_excel(writer, sheet_name="merge",index=False)\n    return df_all\n\n\n\ndef copy_figures(d, p, p0):\n    f_name = os.path.basename(d)\n\n    from PyPDF4 import PdfFileMerger\n    merger = PdfFileMerger(strict=False)\n    for k,v in p0.items():\n        f_path_i = f"{v}/results/{d}"\n        if os.path.exists(f_path_i):\n             merger.append(fileobj=open(f_path_i, \'rb\'), import_bookmarks=True)\n    base, ext = os.path.splitext(f_name)\n    for k,v in p0.items():\n        merger.write(fileobj=open(f\'{v}/results/figures/{base}-merge.pdf\', \'wb\'))\n\n\ndef merge_pdfs(d, p, p0):\n    for k,v in d.items():\n        copy_figures(d=v, p=p, p0=p0)\n    return len(d)\n\n\ndef merge_tables(d, p, p0):\n    vals = d.values()\n    for f,s in vals:\n        merge_table(f, s, p0=p0)\n    return vals\n\n\n\n'}, 'Annotation': ('', 'markdown')}}}, {'class': 'Parameters[dict]', 'name': 'Parameters[dict](2)', 'pos': (4950.0, -2240.0), 'state': {'pos': (4950.0, -2240.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('Params', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Params': 'raw = ["/Quantification-Raw.xlsx", 0]\nspl = ["/Quantification-Spl.xlsx", 0]\nratio = ["/Quantification-Ratio.xlsx", 0]\nrsd = ["/Quantification-Stats.xlsx", 0]\nis_rsd = ["/Quantification-IS.xlsx", "Statistics"]\ncals = ["/Calibrators.best.xlsx", 0]', 'Annotation': ('', 'markdown')}}}, {'class': 'Condition[A|B-O]', 'name': 'Condition[A|B-O](1)', 'pos': (4950.0, -1999.9999999999998), 'state': {'pos': (4950.0, -1999.9999999999998), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('A', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('B', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('O', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Controller': {'check': False, 'spinbox': 0}, 'Condition': 'def f(a,b):\n\treturn b', 'Annotation': ('<!DOCTYPE html>\n<title>(A) 多体系合并</title>', 'markdown')}}}, {'class': 'Cache', 'name': 'Cache(1)', 'pos': (3950.0000000000005, -688.0), 'state': {'pos': (3950.0000000000005, -688.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('Data', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Signal', {'io': 'in', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Out', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False}), ('Path', {'io': 'out', 'multi': False, 'optional': False, 'renamable': False, 'removable': False, 'multiable': False})]), 'ctrl': {'Controller': {'check': False, 'spinbox': 0}, 'Path': './../Calibrator/results/lod-loq.feather', 'Reload': True, 'Annotation': ('', 'markdown')}}}, {'class': 'Merge-Table', 'name': 'Merge-Table(20)', 'pos': (4200.0, -704.0), 'state': {'pos': (4200.0, -704.0), 'bypass': False, 'checked': False, 'terminals': OrderedDict([('Table-left', {'io': 'in', 'multi': False, 'optional': False, 'renamable'